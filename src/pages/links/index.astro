---
import links from 'public/links.json'

import { Collapse } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import FriendList from '@/components/links/FriendList.astro'

const headings = [
  { depth: 2, slug: 'love-links', text: 'Love Links' },
  { depth: 2, slug: 'friend-links', text: 'Friend Links' },
  { depth: 2, slug: 'collect-links', text: 'Collect Links' }
]

const { friends } = links
---

<PageLayout title='Links' {headings} comment={false}>
  <p>友链环节</p>

  <!-- 我的朋友 -->
  <h2 id='love-links'>Love Links</h2>
  <FriendList list={friends[0]} />

  <h2 id='friend-links'>Friend Links</h2>
  {friends[1].link_list.length > 0 && <FriendList list={friends[1]} />}

  <h2 id='collect-links'>Collect Links</h2>
  {friends[4].link_list.length > 0 && <FriendList list={friends[4]} />}

  <!-- 我收藏的网站（折叠列表）
  <h2 id='special-links'>Special Links</h2>
  <Collapse title='开发工具' open>
    <FriendList list={friends[2]} />
  </Collapse> -->

  <!-- 你可以添加更多折叠组 -->
  <!-- <Collapse title='学习资源'>
    <FriendList list={friends[3]} />
  </Collapse> -->
</PageLayout>

<script>
  // Fix negative scroll percentage on short pages
  document.addEventListener('scroll', () => {
    const el = document.querySelector('#to-top-btn .text') as HTMLElement
    if (el && parseInt(el.innerText) < 0) el.innerText = '0'
  })
</script>
