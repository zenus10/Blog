---
import { Button, Collapse, Spoiler, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'

const headings = [
  { depth: 2, slug: 'about-me', text: 'AboutMe' },

  { depth: 2, slug: 'social', text: 'Social' }
]
---

<PageLayout title='About' description:'关于zenus10' {headings} comment>
  <p>你好👋 我是zenus10，你也可以叫我z10</p>

  <blockquote>
    <p><strong>名字的由来:</strong></p>
    <p>
      因为守护星是金星，本人八字也是极强的金命，所以偏爱金星<strong>Venus</strong
      >。又根据本人的名字微调了一下，最后便是<strong>Zenus10</strong>~
    </p>
    <p>z10、zen、10都和我的真名读起来很像，所以大家也都这么叫我啦 :3 (叫z10的比较多)</p>
  </blockquote>

  <p>苦于不知道怎么写about...</p>


  {/* social-networks */}
  <h2 id='social'>Social</h2>
  <Substats
    stats={[
      {
        platform: 'GitHub',
        icon: 'github',
        link: 'https://github.com/zenus10',
        text: 'followers',
        api: 'github/zenus10'
      }
    ]}
  />
  <Timeline
    events={[
      { date: 'Wechat：', content: 'zzz10060928' },
      { date: 'QQ:', content: '3936696535' },
      { date: 'Tiktok:', content: 'Zenus10' }
    ]}
  />
</PageLayout>
