---
import { getCollection } from 'astro:content'

import PageLayout from '@/layouts/CommonPage.astro'
import BookCard from '@/components/books/BookCard.astro'

const allBooks = (await getCollection('books', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)

const favorites = allBooks.filter((book) => book.data.favorite)
const others = allBooks.filter((book) => !book.data.favorite)

const headings = [
  ...(favorites.length ? [{ depth: 2, slug: 'favorites', text: '很喜欢的书' }] : []),
  { depth: 2, slug: 'book-list', text: '书目' }
]
---

<PageLayout title='Books' {headings}>
  <p>书架环节</p>

  <p>
    展示一些我感兴趣或很喜欢的书。标注了"已整理"的书一般是比较小众或绝版的，我将对应的pdf资源整理配备了。没有标注的是网上比较好获取的书籍。
  </p>

  <p>点进去可以查看我的书摘和一些读后感</p>

  {favorites.length > 0 && (
    <h2 id='favorites'>很喜欢的书</h2>
    <div class='grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4'>
      {favorites.map((book) => <BookCard {book} />)}
    </div>
  )}

  <h2 id='book-list'>书目</h2>
  <div class='grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4'>
    {others.map((book) => <BookCard {book} />)}
  </div>
</PageLayout>
